      ],
      "webhookId": "social-agent-approval"
    },
    {
      "parameters": {
        "jsCode": "// Slack sends the click as a form field called `payload` (a JSON string).\nconst p = JSON.parse($input.first().json.body.payload);\nconst action = p.actions[0];\nconst draft = JSON.parse(action.value);\nconst approved = action.action_id === 'approve_draft';\nconst when = new Date().toISOString().replace('T', ' ').slice(0, 16) + ' UTC';\n\n// The post text is the quoted \"post\" block. Strip the \"> \" quoting and Slack's escaping.\nconst postBlock = p.message.blocks.find((b) => b.block_id === 'post');\nconst text = (postBlock?.text?.text ?? '')\n  .split('\\n')\n  .map((line) => line.replace(/^(>|&gt;)\\s?/, ''))\n  .join('\\n')\n  .replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');\n\n// Keep the original message, swap the buttons for the decision.\nconst blocks = p.message.blocks\n  .filter((b) => b.type !== 'actions')\n  .concat({\n    type: 'context',\n    elements: [{ type: 'mrkdwn', text: `${approved ? ':white_check_mark: *Approved*' : ':x: *Rejected*'} by <@${p.user.id}> · ${when}` }],\n  });\n\nreturn [{\n  json: {\n    response_url: p.response_url,\n    message: { replace_original: true, text: p.message.text, blocks },\n    decision: {\n      runId: draft.runId,\n      draftId: draft.draftId,\n      platform: draft.platform ?? '',\n      date: draft.date ?? '',\n      text,\n      fillBeforePosting: draft.fillBeforePosting ?? [],\n      decision: approved ? 'approved' : 'rejected',\n      by: p.user.username || p.user.name || p.user.id,\n      at: new Date().toISOString(),\n    },\n  },\n}];"
      },
      "id": "e17502b3-678b-4abd-9579-ffc08f73fd06",
      "name": "Read decision",
